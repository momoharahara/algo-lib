{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build with gcc",
      "type": "shell",
      "command": "g++",
      "args": [
        "src/a.cpp",
        "-std=gnu++23",
        "-I",
        "lib",
        "-O0",
        "-g",
        "-D_GLIBCXX_DEBUG",
        "-D_GLIBCXX_DEBUG_PEDANTIC",
        "-o",
        "bin/a.out"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
