  "execTL": {
    "prefix": "execTL",
    "body": [
      "#include <sys/time.h>",
      "",
      "double get_ms() {",
      "    struct timeval t;",
      "    gettimeofday(&t, NULL);",
      "    return (double)t.tv_sec * 1000 + (double)t.tv_usec / 1000;",
      "}",
      "",
      "template <typename T>",
      "class ExecTL {",
      "  private:",
      "    int TL;",
      "    T op;",
      "    double start, end;",
      "",
      "  public:",
      "    ExecTL(int TL, T op) : TL(TL), op(op) {",
      "        start = get_ms();",
      "    }",
      "    void exec() {",
      "        while(1) {",
      "            end = get_ms();",
      "            if(end - start > TL)",
      "                break;",
      "            op();",
      "        }",
      "    }",
      "};",
      "",
      "void exec() {",
      "    auto func = [&]() -> void {",
      "        // なにかかく",
      "    };",
      "    constexpr double TL = 1500;",
      "    ExecTL etl = ExecTL(TL, func);",
      "    etl.exec();",
      "}"
    ],
    "description": ""
